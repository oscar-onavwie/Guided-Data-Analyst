# Backend configuration. Copy to backend/.env or export these in your shell.
# No real secrets belong in this file.

# Upload limits
MAX_UPLOAD_MB=20
MAX_ROWS=200000
MAX_COLUMNS=200
MAX_CELLS=5000000

# How long a loaded dataset stays in server memory after its last use, and how many are kept
SESSION_TTL_MINUTES=30
MAX_SESSIONS=20

# Frontend origins allowed to call the API (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional AI explanations — off unless BOTH of these are set
AI_ENABLED=false
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
AI_TIMEOUT_SECONDS=60

# Frontend (put in frontend/.env.local): where the browser should reach the API
# NEXT_PUBLIC_API_URL=http://localhost:8000
